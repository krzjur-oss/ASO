{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Akademia Systemów Operacyjnych",
  "short_name": "Akademia SO",
  "description": "Interaktywny symulator systemów plików Windows 11 i Linux Ubuntu dla uczniów",
  "id": "/ASO/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#2E3440",
  "theme_color": "#5E81AC",
  "categories": ["education", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Eksplorator Windows",
      "short_name": "Windows",
      "description": "Symulator Eksploratora Windows 11",
      "url": "./index.html",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Terminal Linux",
      "short_name": "Linux",
      "description": "Symulator Terminala Linux Bash",
      "url": "./index.html",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
